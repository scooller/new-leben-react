{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-search-tutorial",
	"main": "src/index.js",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"API_BASE": "https://dev.ileben.cl",
		"AUTHORIZED_ORIGIN": "https://test.ileben.cl"
	}
}
