# WordPress Leben MCP Configuration
WP_MCP_TOKEN=your_token_here
WP_MCP_URL=https://ileben.cl/wp-json/mcp/v1/http

# Vite Dev Proxy API Configuration
DEV_API_TOKEN=your_dev_api_token_here
DEV_API_TARGET=https://dev.ileben.cl

# Tracking & Analytics (Google Analytics 4 & Meta Pixel)
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Cloudflare Turnstile CAPTCHA
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Additional environment variables for development
DEV_API_ORIGIN=https://test.ileben.cl
DEV_API_REFERER=https://test.ileben.cl/